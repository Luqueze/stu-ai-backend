# Copy to .env on the EC2 instance (never commit the real file)

# RDS (from `terraform output` in infra/terraform)
DB_HOST=ai-exam-db.xxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=

# RabbitMQ (container-internal, choose your own values)
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# auth-service / exam-service / api-gateway
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
API_KEY_ENCRYPTION_SECRET=
# Origin(s) allowed to call the API from a browser (your S3/frontend URL), comma-separated
CORS_ALLOWED_ORIGINS=http://your-frontend-bucket.s3-website-us-east-1.amazonaws.com

# auth-service password reset email (real SMTP provider, e.g. SendGrid, Mailgun, SES)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@yourdomain.com
FRONTEND_URL=https://yourdomain.com
PASSWORD_RESET_TOKEN_EXPIRATION_MS=1800000

# ai-generator-service
# Use "openai" with OPENAI_API_KEY, or "ollama" pointed at a tunnel (e.g. ngrok)
# to your machine's local Ollama - only works while you're hosting it.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
