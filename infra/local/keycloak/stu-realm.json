{
  "realm": "stu",
  "displayName": "STU",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "passwordPolicy": "length(8) and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@stu.local",
    "fromDisplayName": "STU"
  },
  "roles": {
    "realm": [
      { "name": "STUDENT", "description": "Aluno da plataforma" },
      { "name": "ADMIN", "description": "Administrador da plataforma" },
      { "name": "offline_access" },
      { "name": "uma_authorization" },
      {
        "name": "default-roles-stu",
        "composite": true,
        "composites": {
          "realm": ["STUDENT", "offline_access", "uma_authorization"]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-stu",
    "composite": true
  },
  "clients": [
    {
      "clientId": "stu-frontend",
      "name": "STU Frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "stu-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "stu-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "stu-swagger",
      "name": "STU Swagger UI",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8086/swagger-ui/oauth2-redirect.html",
        "http://localhost:8087/swagger-ui/oauth2-redirect.html",
        "http://localhost:8088/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": ["http://localhost:8086", "http://localhost:8087", "http://localhost:8088"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "stu-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "stu-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@stu.local",
      "email": "admin@stu.local",
      "firstName": "Admin",
      "lastName": "STU",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin12345", "temporary": false }],
      "realmRoles": ["default-roles-stu", "ADMIN"]
    },
    {
      "username": "aluno@stu.local",
      "email": "aluno@stu.local",
      "firstName": "Aluno",
      "lastName": "Teste",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "aluno12345", "temporary": false }],
      "realmRoles": ["default-roles-stu"]
    }
  ]
}
